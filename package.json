{
  "name": "transactional-refactor-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Experimental transactional TypeScript refactoring over MCP with a shadow VFS and LSP diagnostic verification.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --test dist/tests/vfs.test.js dist/tests/lsp-handshake.test.js dist/tests/verify.test.js dist/tests/mcp.test.js",
    "test:vfs": "npm run build && node --test dist/tests/vfs.test.js",
    "test:lsp": "npm run build && node --test dist/tests/lsp-handshake.test.js",
    "test:verify": "npm run build && node --test dist/tests/verify.test.js",
    "test:mcp": "npm run build && node --test dist/tests/mcp.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^3.25.76",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-types": "^3.17.5",
    "diff": "^8.0.2",
    "typescript": "~5.9.3",
    "typescript-language-server": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0"
  }
}
